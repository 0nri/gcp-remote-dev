#!/usr/bin/env bash
# =============================================================================
# GCP Remote Dev VM — Configuration
# Copy to config.env, edit the values below, then run: ./provision.sh
#
# Sections 1–5 apply to every VM. Section 6 is only read when
# ACCESS_MODE="iap"; with ACCESS_MODE="public" you can leave it untouched.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GCP project & location
# -----------------------------------------------------------------------------
PROJECT_ID="YOUR_PROJECT_ID"           # ← Fill in your GCP project ID
REGION="us-west1"
ZONE="${REGION}-b"

# -----------------------------------------------------------------------------
# 2. VM
# -----------------------------------------------------------------------------
VM_NAME="remote-dev"
MACHINE_TYPE="e2-standard-4"          # 4 vCPU / 16 GB RAM
BOOT_DISK_SIZE="50"                    # GB
BOOT_DISK_TYPE="pd-ssd"
VM_USER="YOUR_USERNAME"                # ← Linux username on the VM (e.g. "devuser")
SERVICE_ACCOUNT_NAME="remote-dev-sa"   # VM identity used for Vertex AI (no API keys)

# -----------------------------------------------------------------------------
# 3. Networking & access mode
# -----------------------------------------------------------------------------
NETWORK="vpc-0"                        # VPC network (offered for creation if missing)
SUBNET="subnet-0"                      # Subnet of $NETWORK in $REGION
SUBNET_RANGE="10.10.0.0/24"            # Used ONLY when the script creates $NETWORK;
                                       # never adds subnets to an existing network

# "iap"    (default) — no public IP; SSH only via IAP tunnel (needs gcloud on
#                      the client, so desktop only); Cloud NAT for egress.
#                      Also fill in section 6.
# "public" — reserved static external IP; SSH (tcp:22) + Mosh (udp:60000-60010)
#            open to this VM only (tag-scoped firewall), key-only auth, fail2ban.
#            Required for mobile clients such as Termius on iOS.
# Override at runtime with: ./provision.sh --access=public
ACCESS_MODE="iap"

# -----------------------------------------------------------------------------
# 4. SSH keys
# -----------------------------------------------------------------------------
# File of PUBLIC keys allowed to log in as VM_USER — one line per device
# (typically: this Mac + your Termius iPhone). Standard .pub format, '#' comments OK.
# If missing/empty, provision.sh generates ~/.ssh/<VM_NAME>_ed25519 on this
# machine and creates the file with that key. Push edits to an existing VM with:
#   ./provision.sh --update-keys
SSH_KEYS_FILE="${SCRIPT_DIR}/authorized_keys"

# -----------------------------------------------------------------------------
# 5. AI tools (Vertex AI)
# -----------------------------------------------------------------------------
# Comma-separated CLIs for setup-user.sh to install: agy, claude (default: agy)
# Override at runtime with: ./provision.sh --tools=agy,claude
INSTALL_TOOLS="agy"
VERTEX_REGION="global"
CLAUDE_MODEL="claude-opus-4-7"         # Only used if claude is installed

# -----------------------------------------------------------------------------
# 6. IAP mode only (ignored when ACCESS_MODE="public")
# -----------------------------------------------------------------------------
IAP_USER="YOUR_EMAIL@example.com"      # ← GCP user to grant IAP tunnel access

# =============================================================================
# Derived values — do not edit below this line
# =============================================================================
SERVICE_ACCOUNT_EMAIL="${SERVICE_ACCOUNT_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# IAP mode only: Cloud Router + NAT (egress for the private VM) and IAP SSH rule.
# (Public-mode resource names — static IP, firewall rule, network tag — are
#  derived from VM_NAME inside provision.sh.)
NAT_GW_NAME="${NETWORK}-${REGION}-nat-gw"
ROUTER_NAME="${NETWORK}-${REGION}-router"
FIREWALL_RULE_NAME="allow-iap-ssh-${NETWORK}"
