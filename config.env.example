#!/usr/bin/env bash
# =============================================================================
# GCP Remote Dev VM — Configuration
# Edit the values below, then run: ./provision.sh
# =============================================================================

# --- GCP Project ---
PROJECT_ID="YOUR_PROJECT_ID"           # ← Fill in your GCP project ID

# --- Region & Zone ---
REGION="us-west1"
ZONE="${REGION}-b"

# --- VM Configuration ---
VM_NAME="remote-dev"
MACHINE_TYPE="e2-standard-4"          # 4 vCPU / 16 GB RAM
BOOT_DISK_SIZE="50"                    # GB
BOOT_DISK_TYPE="pd-ssd"
VM_USER="YOUR_USERNAME"                # Linux username on the VM (e.g. "devuser")

# --- Networking ---
NETWORK="vpc-0"
SUBNET="subnet-0"                         # Subnet name in $REGION (adjust if different)

# --- Service Account ---
SERVICE_ACCOUNT_NAME="remote-dev-sa"

# --- IAP Access ---
IAP_USER="YOUR_EMAIL@example.com"      # ← GCP user/group to grant IAP tunnel access

# --- SSH Access ---
# Optional: paste the contents of your public key file (e.g. ~/.ssh/id_ed25519.pub).
# If set, the startup script writes it to authorized_keys at first boot so
# 'gcloud compute ssh' bootstrap is not required for first login.
SSH_PUBLIC_KEY=""

# --- AI / Vertex AI ---
VERTEX_REGION="global"
CLAUDE_MODEL="claude-opus-4-7"

# =============================================================================
# Derived values — do not edit below this line
# =============================================================================
SERVICE_ACCOUNT_EMAIL="${SERVICE_ACCOUNT_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"
NAT_GW_NAME="${NETWORK}-${REGION}-nat-gw"
ROUTER_NAME="${NETWORK}-${REGION}-router"
FIREWALL_RULE_NAME="allow-iap-ssh-${NETWORK}"
